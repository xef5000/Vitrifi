<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>dev.vitrifi</groupId><artifactId>vitrifi-parent</artifactId><version>0.3.0</version><relativePath>../../pom.xml</relativePath></parent>
  <artifactId>spring-checkout</artifactId>
  <dependencies>
    <dependency><groupId>dev.vitrifi</groupId><artifactId>vitrifi-java</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><version>2.3.232</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version>
        <executions><execution><id>analysis-classpath</id><phase>generate-resources</phase><goals><goal>build-classpath</goal></goals>
          <configuration><outputFile>${project.build.directory}/vitrifi-classpath.txt</outputFile></configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
